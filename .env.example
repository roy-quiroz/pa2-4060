PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/solicitudes_academicas

# JWT: usa una cadena larga y aleatoria en tu .env (no la subas a GitHub)
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# CORS: frontends permitidos, separados por coma
CORS_ORIGIN=http://localhost:5173

# Datos del administrador inicial (npm run crear-admin)
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@isil.pe
ADMIN_PASSWORD=cambia_esta_contraseña
